{
  "id": "A42",
  "title": "rpi-init reviews the configuration against the release notes after a suite update",
  "fixture": {
    "seeds": [
      "node-app",
      "configured-specs"
    ],
    "replace": {
      "AGENTS_APP.md": [
        [
          "suite_version: 3.1.0",
          "suite_version: 1.0.0"
        ],
        [
          "features: { working: work/features, completed: work/done, specifications: work/specs }",
          "features: { working: work/features, completed: work/done }"
        ]
      ]
    }
  },
  "disable": [
    "structured-question"
  ],
  "turns": [
    {
      "say": "Use the rpi-init skill to review the feature workflow configuration after the suite update."
    },
    {
      "repeat": "Yes, I confirm the proposed differences. Apply them.",
      "until": [
        {
          "type": "contains",
          "path": "AGENTS_APP.md",
          "pattern": "specifications:\\s*work/specs"
        }
      ],
      "max": 3
    }
  ],
  "assert": [
    {
      "type": "section-count",
      "path": "AGENTS_APP.md",
      "heading": "## Feature workflow",
      "count": 1
    },
    {
      "type": "contains",
      "path": "AGENTS_APP.md",
      "pattern": "specifications:\\s*work/specs"
    },
    {
      "type": "contains",
      "path": "AGENTS_APP.md",
      "pattern": "suite_version:\\s*(?!1\\.0\\.0)\\d+\\.\\d+\\.\\d+"
    },
    {
      "type": "not-contains",
      "path": "AGENTS_APP.md",
      "pattern": "suite_version:\\s*1\\.0\\.0"
    },
    {
      "type": "changes-within",
      "paths": [
        "AGENTS_APP.md"
      ]
    },
    {
      "type": "contains",
      "transcript": "all",
      "pattern": "rpi:check|suite check"
    }
  ]
}
