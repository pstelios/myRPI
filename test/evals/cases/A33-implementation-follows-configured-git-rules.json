{
  "id": "A33",
  "title": "Implementation follows configured git rules",
  "fixture": {
    "seeds": [
      "node-app",
      "configured",
      "shout-approved"
    ]
  },
  "disable": [
    "structured-question"
  ],
  "turns": [
    {
      "say": "Use the rpi-implement skill to implement the shout feature."
    },
    {
      "repeat": "Use the recommended option. Do not archive the feature yet.",
      "until": [
        {
          "type": "frontmatter",
          "path": "work/features/shout/shout-plan.md",
          "key": "status",
          "equals": "verified"
        }
      ],
      "max": 5
    }
  ],
  "assert": [
    {
      "type": "git",
      "commits": 1
    },
    {
      "type": "git",
      "branch_unchanged": true
    }
  ]
}
