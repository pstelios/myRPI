{
  "id": "A07",
  "title": "rpi-init updates an existing configuration instead of duplicating it",
  "fixture": {
    "seeds": [
      "node-app",
      "configured"
    ],
    "replace": {
      "AGENTS.md": [
        [
          "full: [npm run check]",
          "full: [npm test]"
        ]
      ]
    }
  },
  "disable": [
    "structured-question"
  ],
  "turns": [
    {
      "say": "Use the rpi-init skill to review and update the feature workflow configuration for this repository."
    },
    {
      "repeat": "Yes, I confirm the proposed differences. Apply them.",
      "until": [
        {
          "type": "contains",
          "path": "AGENTS.md",
          "pattern": "npm run check"
        }
      ],
      "max": 3
    }
  ],
  "assert": [
    {
      "type": "section-count",
      "path": "AGENTS.md",
      "heading": "## Feature workflow",
      "count": 1
    },
    {
      "type": "contains",
      "path": "AGENTS.md",
      "pattern": "npm run check"
    },
    {
      "type": "changes-within",
      "paths": [
        "AGENTS.md"
      ]
    }
  ]
}
